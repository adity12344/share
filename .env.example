# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model alias for Gemini SDK (Default: gemini-3.7-flash)
GEMINI_MODEL="gemini-3.7-flash"

# CAMPUS_ASSISTANT_RATE_LIMIT: Max messages per minute per user for Campus Assistant (Default: 10)
CAMPUS_ASSISTANT_RATE_LIMIT="10"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (also available via NEXT_PUBLIC_ or VITE_ prefix)
NEXT_PUBLIC_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="MY_FIREBASE_AUTH_DOMAIN"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="MY_FIREBASE_STORAGE_BUCKET"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="MY_FIREBASE_MESSAGING_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
